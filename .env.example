# --- Sitio marketing ---
NEXT_PUBLIC_SITE_URL=https://isaprespremium.cl
NEXT_PUBLIC_WHATSAPP_NUMBER=56964133848

# --- Neon PostgreSQL ---
# Desarrollo (default local y preview). Nunca uses el host de producción aquí.
DATABASE_URL_DEV="postgresql://USER:PASSWORD@HOST-DEV-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL_DEV="postgresql://USER:PASSWORD@HOST-DEV.REGION.aws.neon.tech/neondb?sslmode=require"
# Producción: solo Vercel production (VERCEL_ENV=production) o APP_ENV=production.
DATABASE_URL_PROD="postgresql://USER:PASSWORD@HOST-PROD-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL_PROD="postgresql://USER:PASSWORD@HOST-PROD.REGION.aws.neon.tech/neondb?sslmode=require"
# Prisma resuelve DATABASE_URL / DIRECT_URL según el entorno (lib/db/resolve-database-env.mjs).
# Compatibilidad Vercel actual: si no existe DATABASE_URL_PROD, production usa DATABASE_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
# Escritura manual a PROD (migrate deploy local): APP_ENV=production CONFIRM_PRODUCTION_DB=1
# APP_ENV=development
# CONFIRM_PRODUCTION_DB=

# Autenticación staff (mínimo 32 caracteres)
AUTH_SECRET=

# URL pública del motor (links en correos, widget y deep links)
NEXT_PUBLIC_APP_URL=https://isaprespremium.cl
APP_BASE_URL=https://isaprespremium.cl
NEXT_PUBLIC_COTIZADOR_ROUTING=premium

# Entidad aliada por defecto en /cotizador
DEFAULT_PARTNER_ENTITY_SLUG=isaprespremium

# API pública para integradores
PUBLIC_API_SECRET=

# Orígenes iframe / CORS (opcional; incluye landing cotizadorpremium.cl)
# EMBED_FRAME_ANCESTORS=https://cotizadorpremium.cl,https://www.cotizadorpremium.cl
# ALLOWED_PUBLIC_ORIGINS=https://cotizadorpremium.cl,https://isaprespremium.cl

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Correos (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=Isapres Premium <contacto@isaprespremium.cl>
RESEND_COTIZACION_FROM_EMAIL=Isapres Premium <cotizaciones@isaprespremium.cl>
RESEND_EQUIPO_FROM_EMAIL=Isapres Premium <equipo@isaprespremium.cl>
COTIZACION_NOTIFY_EMAIL=cotizaciones@isaprespremium.cl
ADMIN_EMAIL=contacto@isaprespremium.cl
ADMIN_CC_EMAIL=premiumisapres@gmail.com

# --- PDFs de planes ---
PLAN_PDF_STORAGE=blob
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

