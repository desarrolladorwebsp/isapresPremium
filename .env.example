# --- Sitio marketing ---
NEXT_PUBLIC_SITE_URL=https://isaprespremium.cl
NEXT_PUBLIC_WHATSAPP_NUMBER=56964133848

# --- Neon PostgreSQL (misma DB del cotizador) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Autenticación staff (mínimo 32 caracteres)
AUTH_SECRET=

# URL pública del motor (links en correos, widget y deep links)
NEXT_PUBLIC_APP_URL=https://isaprespremium.cl
APP_BASE_URL=https://isaprespremium.cl
NEXT_PUBLIC_COTIZADOR_ROUTING=premium

# Entidad aliada por defecto en /cotizador
DEFAULT_PARTNER_ENTITY_SLUG=isaprespremium

# API pública para integradores
PUBLIC_API_SECRET=

# Orígenes iframe / CORS (opcional; incluye landing cotizadorpremium.cl)
# EMBED_FRAME_ANCESTORS=https://cotizadorpremium.cl,https://www.cotizadorpremium.cl
# ALLOWED_PUBLIC_ORIGINS=https://cotizadorpremium.cl,https://isaprespremium.cl

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Correos (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=Isapres Premium <contacto@isaprespremium.cl>
RESEND_COTIZACION_FROM_EMAIL=Isapres Premium <cotizaciones@isaprespremium.cl>
RESEND_EQUIPO_FROM_EMAIL=Isapres Premium <equipo@isaprespremium.cl>
COTIZACION_NOTIFY_EMAIL=cotizaciones@isaprespremium.cl
ADMIN_EMAIL=contacto@isaprespremium.cl
ADMIN_CC_EMAIL=premiumisapres@gmail.com

# --- PDFs de planes ---
PLAN_PDF_STORAGE=blob
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

